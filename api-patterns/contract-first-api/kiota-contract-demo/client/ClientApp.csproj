<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ClientApp</RootNamespace>

    <!-- The client's OWN release version. -->
    <Version>2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kiota runtime: abstractions + HttpClient adapter + JSON/text/form/multipart serializers.
         Version matches what Kiota 1.36.1 asks for (`dotnet kiota info -l CSharp`). -->
    <PackageReference Include="Microsoft.Kiota.Bundle" Version="2.1.2" />
  </ItemGroup>

</Project>
