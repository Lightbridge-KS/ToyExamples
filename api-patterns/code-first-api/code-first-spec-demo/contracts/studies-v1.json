{
  "openapi": "3.1.1",
  "info": {
    "title": "Studies API",
    "version": "1.1.0"
  },
  "paths": {
    "/api/v1/studies": {
      "get": {
        "tags": [
          "Gateway"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StudyV1"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/studies/{id}": {
      "get": {
        "tags": [
          "Gateway"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudyV1"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Modality": {
        "enum": [
          "CT",
          "MR",
          "US",
          "XR",
          "MG"
        ]
      },
      "Priority": {
        "enum": [
          "Routine",
          "Stat"
        ],
        "default": "Routine"
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "StudyV1": {
        "required": [
          "id",
          "patientName",
          "modality"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "patientName": {
            "type": "string"
          },
          "modality": {
            "$ref": "#/components/schemas/Modality"
          },
          "priority": {
            "$ref": "#/components/schemas/Priority"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Gateway"
    }
  ]
}